# MAB PMS backend — example configuration. Copy to .env for local development.
# Placeholders only. Never commit a real .env file or real credentials.

NODE_ENV=development
HOST=127.0.0.1
PORT=4000
LOG_LEVEL=info

# Local MongoDB only. A remote database (e.g. MongoDB Atlas) additionally needs
# MONGODB_ALLOW_REMOTE=true and must be separately authorised before use.
MONGODB_URI=mongodb://127.0.0.1:27017/?replicaSet=rs0
MONGODB_DB_NAME=pms_dev
MONGODB_ALLOW_REMOTE=false
# Transactions need a replica set. Set to false only for a local standalone server.
MONGODB_REQUIRE_TRANSACTIONS=true
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000

# Comma-separated list of allowed browser origins (no "*", no paths).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
REQUEST_BODY_LIMIT=100kb
# Number of trusted reverse-proxy hops (Render: 1). 0 for local development.
TRUST_PROXY=0
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300

# Sessions (server-side, HttpOnly cookie). Secure cookies are forced on in production.
SESSION_TTL_HOURS=12
SESSION_IDLE_MINUTES=120
SESSION_COOKIE_SECURE=false
# lax for same-site setups; "none" (requires Secure) only if frontend and API are on different sites.
SESSION_COOKIE_SAMESITE=lax
# Sign-in protection
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=20
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15
